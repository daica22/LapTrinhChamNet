<Window x:Class="QuanLySinhVien.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý sinh viên"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Thông tin sinh viên" Grid.Row="0" Margin="5">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Label Content="Mã SV:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txt_MaSV" Grid.Row="0" Grid.Column="1" Height="28"/>
                <Label Content="Họ tên:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txt_HoTen" Grid.Row="0" Grid.Column="3" Height="28"/>
                <Label Content="Ngày sinh:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <DatePicker x:Name="date_NgaySinh" Grid.Row="1" Grid.Column="1" Height="28"/>
                <Label Content="Giới tính:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="3"  Orientation="Horizontal">
                    <RadioButton x:Name="rdo_Nam" Content="Nam" Margin="5"/>
                    <RadioButton x:Name="rdo_Nu" Content="Nữ"  Margin="5"/>
                    <RadioButton x:Name="rdo_Khac" Content="Khác" Margin="5"/>
                </StackPanel>
                <Label Content="Khoa:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="cb_Khoa" Grid.Row="2" Grid.Column="1" Height="28" DisplayMemberPath="TenKhoa" SelectedValuePath="MaKhoa"/>
            </Grid>

        </GroupBox>

        <DataGrid x:Name="dg_SinhVien" Grid.Row="1" Margin="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Dg_SinhVien_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSV}" Width="100"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="200"/>
                <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" Width="100"/>
                <DataGridTextColumn Header="Khoa" Binding="{Binding KHOA.TenKhoa}" Width="200"/>
            </DataGrid.Columns>

        </DataGrid>


        <StackPanel Grid.Row="2" Orientation="Horizontal"  HorizontalAlignment="Center">
            <Button Content="Thêm" Width="100" Height="35" Margin="5" Click="them"/>
            <Button Content="Sửa" Width="100" Height="35" Margin="5" Click="sua"/>
            <Button Content="Xóa" Width="100" Height="35"  Margin="5" Click="xoa"/>
            <Button Content="Làm mới" Width="100" Height="35" Margin="5" Click="lamMoi"/>

        </StackPanel>

    </Grid>

</Window>
